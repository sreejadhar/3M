# ── Stage 1: builder ──────────────────────────────────────────────────────────
FROM python:3.11-slim AS builder

WORKDIR /build

COPY requirements.shacl.txt .
RUN pip install --no-cache-dir --prefix=/install -r requirements.shacl.txt

# ── Stage 2: runtime ──────────────────────────────────────────────────────────
FROM python:3.11-slim

WORKDIR /app

# Copy installed packages from builder
COPY --from=builder /install /usr/local

# Copy only the SHACL agent source
COPY shacl_agent/ ./shacl_agent/
COPY shacl_api.py .
COPY llm_client.py .

ENV PYTHONUNBUFFERED=1

EXPOSE 8007

CMD ["python", "-m", "uvicorn", "shacl_api:app", "--host", "0.0.0.0", "--port", "8007"]

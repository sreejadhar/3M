# ── Stage 1: dependency builder ────────────────────────────────────────────────
FROM python:3.11-slim AS builder

WORKDIR /build

COPY requirements.ui.txt .
RUN pip install --no-cache-dir --prefix=/install -r requirements.ui.txt


# ── Stage 2: runtime image ─────────────────────────────────────────────────────
FROM python:3.11-slim AS runtime

LABEL maintainer="metadata-agent" \
      description="Metadata Extraction Agent — Streamlit UI"

RUN groupadd -r ui && useradd -r -g ui ui

WORKDIR /app

COPY --from=builder /install /usr/local

# Copy the Streamlit app, auth proxy, startup script and theme config
COPY app.py                   /app/app.py
COPY llm_client.py            /app/llm_client.py
COPY streamlit_auth_proxy.py  /app/streamlit_auth_proxy.py
COPY start_ui.sh              /app/start_ui.sh
COPY .streamlit/              /app/.streamlit/

RUN sed -i 's/\r//' /app/start_ui.sh && chmod +x /app/start_ui.sh && chown -R ui:ui /app

ENV AGENT_API_URL=http://agent-api:8000 \
    PYTHONUNBUFFERED=1

USER ui

# 8502 is the auth proxy (public); 8501 is Streamlit (internal only)
EXPOSE 8502

HEALTHCHECK --interval=20s --timeout=10s --start-period=60s --retries=5 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8502/health')"

CMD ["/app/start_ui.sh"]

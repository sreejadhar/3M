# ── Stage 1: builder ─────────────────────────────────────────────────────────
FROM python:3.11-slim AS builder

WORKDIR /build
COPY requirements.orchestrator.txt .
RUN pip install --no-cache-dir --prefix=/install -r requirements.orchestrator.txt

# ── Stage 2: runtime ─────────────────────────────────────────────────────────
FROM python:3.11-slim

WORKDIR /app

# Copy installed packages
COPY --from=builder /install /usr/local

# Copy the orchestrator API, metadata catalog, and the static chat UI
COPY orchestrator_api.py .
COPY metadata_catalog.py .
COPY kpi_store.py .
COPY kg_store.py .
COPY access_control.py .
COPY chat_ui/ ./chat_ui/

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

EXPOSE 8005

CMD ["uvicorn", "orchestrator_api:app", "--host", "0.0.0.0", "--port", "8005", "--log-level", "info"]

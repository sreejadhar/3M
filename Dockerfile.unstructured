# ── Stage 1: builder ──────────────────────────────────────────────────────────
FROM python:3.11-slim AS builder

WORKDIR /build

COPY requirements.unstructured.txt .
RUN pip install --no-cache-dir --prefix=/install -r requirements.unstructured.txt

# ── Stage 2: runtime ──────────────────────────────────────────────────────────
FROM python:3.11-slim

WORKDIR /app

# Copy installed packages from builder
COPY --from=builder /install /usr/local

# Copy only the Document Intelligence agent source
COPY unstructured_agent/ ./unstructured_agent/
COPY unstructured_api.py .

ENV PYTHONUNBUFFERED=1

EXPOSE 8008

CMD ["python", "-m", "uvicorn", "unstructured_api:app", "--host", "0.0.0.0", "--port", "8008"]

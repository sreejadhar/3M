# ── Stage 1: dependency builder ────────────────────────────────────────────────
# No apt-get needed: every package in requirements.agent.txt ships a
# prebuilt binary wheel (psycopg2-binary, pyodbc>=5.0 manylinux wheels).
FROM python:3.11-slim-bookworm AS builder

WORKDIR /build

COPY requirements.agent.txt .
RUN pip install --no-cache-dir --prefix=/install \
        --timeout=120 --retries=5 \
        -r requirements.agent.txt


# ── Stage 2: runtime image ─────────────────────────────────────────────────────
FROM python:3.11-slim-bookworm AS runtime

LABEL maintainer="metadata-agent" \
      description="Metadata Extraction Agent — FastAPI backend"

ENV DEBIAN_FRONTEND=noninteractive

# System libs + Microsoft ODBC Driver 18 for SQL Server
RUN rm -rf /var/lib/apt/lists/* /var/cache/apt/archives/* \
    && apt-get clean \
    && apt-get update --fix-missing -o Acquire::Retries=5 -o Acquire::http::Timeout=30 \
    && apt-get install -y --no-install-recommends --fix-missing \
        curl gnupg2 unixodbc \
    && curl -fsSL https://packages.microsoft.com/keys/microsoft.asc \
       | gpg --dearmor -o /usr/share/keyrings/microsoft-prod.gpg \
    && curl -fsSL https://packages.microsoft.com/config/debian/12/prod.list \
       -o /etc/apt/sources.list.d/mssql-release.list \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get update --fix-missing -o Acquire::Retries=5 -o Acquire::http::Timeout=30 \
    && ACCEPT_EULA=Y apt-get install -y --no-install-recommends --fix-missing msodbcsql18 \
    && rm -rf /var/lib/apt/lists/* /var/cache/apt/archives/*

# Non-root user for security
RUN groupadd -r agent && useradd -r -g agent agent

WORKDIR /app

# Copy installed packages from builder
COPY --from=builder /install /usr/local

# Copy the metadata_agent package into /app/metadata_agent/
RUN mkdir -p /app/metadata_agent
COPY __init__.py      /app/metadata_agent/__init__.py
COPY agent.py         /app/metadata_agent/agent.py
COPY config.py        /app/metadata_agent/config.py
COPY state.py         /app/metadata_agent/state.py
COPY connectors/      /app/metadata_agent/connectors/
COPY tools/           /app/metadata_agent/tools/
COPY nodes/           /app/metadata_agent/nodes/

# Copy the ontology_agent package into /app/ontology_agent/
COPY ontology_agent/ /app/ontology_agent/

# Copy the FastAPI entry-point
COPY api.py /app/api.py

# Data volume for reports and history
RUN mkdir -p /data/reports && chown -R agent:agent /data /app
VOLUME ["/data/reports"]

# PYTHONPATH so `import metadata_agent` resolves to /app/metadata_agent
ENV PYTHONPATH=/app \
    DATA_DIR=/data/reports \
    PYTHONUNBUFFERED=1

USER agent

EXPOSE 8000

HEALTHCHECK --interval=15s --timeout=5s --start-period=90s --retries=8 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/health', timeout=4)"

CMD ["uvicorn", "api:app", \
     "--host", "0.0.0.0", \
     "--port", "8000", \
     "--workers", "1", \
     "--log-level", "info"]

# ── Stage 1: builder ─────────────────────────────────────────────────────────
FROM python:3.11-slim AS builder

WORKDIR /build
COPY requirements.unstructured.txt .
RUN pip install --no-cache-dir --prefix=/install -r requirements.unstructured.txt

# ── Stage 2: runtime ─────────────────────────────────────────────────────────
FROM python:3.11-slim

WORKDIR /app

COPY --from=builder /install /usr/local

COPY unstructured_agent/ ./unstructured_agent/
COPY unstructured_api.py .
COPY llm_client.py .

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

EXPOSE 8008

CMD ["uvicorn", "unstructured_api:app", "--host", "0.0.0.0", "--port", "8008", "--log-level", "info"]

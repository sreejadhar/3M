# ── Stage 1: builder ─────────────────────────────────────────────────────────
FROM python:3.11-slim AS builder

WORKDIR /build
COPY requirements.tech.txt .
RUN pip install --no-cache-dir --prefix=/install -r requirements.tech.txt

# ── Stage 2: runtime ─────────────────────────────────────────────────────────
FROM python:3.11-slim

WORKDIR /app

# Copy installed packages
COPY --from=builder /install /usr/local

# Copy the server entrypoint and the static UI assets
COPY tech_ui_server.py .
COPY tech_ui/ ./tech_ui/

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

EXPOSE 8006

CMD ["uvicorn", "tech_ui_server:app", "--host", "0.0.0.0", "--port", "8006", "--log-level", "info"]

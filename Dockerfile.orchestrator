# ── Stage 1: builder ──────────────────────────────────────────────────────────
FROM python:3.11-slim AS builder

WORKDIR /build
COPY requirements.orchestrator.txt .
RUN pip install --no-cache-dir --prefix=/install -r requirements.orchestrator.txt

# ── Stage 2: runtime ──────────────────────────────────────────────────────────
FROM python:3.11-slim

WORKDIR /app

COPY --from=builder /install /usr/local

# Core entry-point and supporting modules
COPY orchestrator_api.py .
COPY session_store.py .
COPY kpi_store.py .
COPY kg_store.py .
COPY metadata_catalog.py .
COPY access_control.py .
COPY ontology_enricher.py .
COPY snowflake_auth.py .
COPY config.py .
COPY llm_client.py .
COPY excel_export.py .
COPY business_classifier.py .
COPY domain_classifier.py .
COPY connectors/ ./connectors/

# orchestrator_api imports dialog_agent.kg_bridges / kg_registry / kg_router /
# kg_inference_engine / pg_store / nodes.execute_node for cross-source bridge
# inference (see dialog_agent/__init__.py's ImportError guard around agent.py,
# which exists specifically so these lightweight submodules stay importable
# here without the full dialog_agent requirement set). Without this package
# present, every bridge-inference call site silently no-ops.
COPY dialog_agent/ ./dialog_agent/

# Chat UI static assets served by the orchestrator
COPY chat_frontend/dist/ ./chat_frontend/dist/

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

EXPOSE 8005

CMD ["uvicorn", "orchestrator_api:app", "--host", "0.0.0.0", "--port", "8005", "--log-level", "info"]
